# PostgreSQL. Keep credentials in the platform secret store.
DATABASE_URL=
DB_SSLMODE=prefer
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_ACQUIRE_TIMEOUT=2
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=3000
DB_POOL_MAX_IDLE_SECONDS=300
DB_POOL_MAX_LIFETIME_SECONDS=1800
DB_APPLICATION_NAME=achilles-recommendations

# Shared with Laravel; never expose this value to browsers.
RECOMMENDATION_SERVICE_KEY=

# Ten-minute per-process snapshot. Failed refreshes retry after 30 seconds.
CATALOG_CACHE_TTL_SECONDS=600
CATALOG_REFRESH_RETRY_SECONDS=30
CATALOG_INITIAL_WAIT_SECONDS=3

# Zero preserves all available history.
ACTIVITY_HISTORY_DAYS=0

# Optional shared rate-limit store. Empty uses a bounded per-process fallback.
REDIS_URL=
RECOMMENDATION_RATE_LIMIT_PER_MINUTE=120
REFRESH_RATE_LIMIT_PER_MINUTE=2
RECOMMENDATION_MAX_CONCURRENCY=4
RECOMMENDATION_SLOT_TIMEOUT_SECONDS=0.25
MAX_REQUEST_BYTES=16384

# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For.
TRUSTED_PROXIES=

# Gunicorn: begin with two workers/two threads and measure memory before scaling.
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
PORT=5000
